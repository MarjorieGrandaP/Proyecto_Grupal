# Configuración de Base de Datos PostgreSQL
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pcfix_db
DB_USER=postgres
DB_PASSWORD=tu_contrasena_postgresql

# Clave utilizada por Flask para sesiones y protección CSRF.
# Cada integrante debe generar su propia clave local.
SECRET_KEY=tu_clave_secreta_aqui

RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
# Bootstrap opcional del primer administrador (solo si no existe ningún admin).
# Define las tres variables en el entorno privado; nunca las publiques en Git.
# Usuario: 3-50 letras. Contraseña: 8-100 caracteres, mayúscula, minúscula,
# número y al menos uno de @ # * !. No cambia cuentas existentes.
# Puedes retirar las tres variables después de crear el administrador.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tarifa de proyecto como fracción; las facturas emitidas conservan su tarifa.
IVA_RATE=0.15
# Datos privados de transferencia, visibles solo al solicitar un pago.
PAYMENT_BANK=
PAYMENT_ACCOUNT_TYPE=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_HOLDER=
